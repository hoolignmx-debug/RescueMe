            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"field1\",\n  \"password\": \"field123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged in', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('fieldToken', pm.response.json().access_token);"
