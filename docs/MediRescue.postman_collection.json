            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scan_data\": {{scanData}},\n  \"face_detected\": true,\n  \"quality_score\": 0.9,\n  \"latitude\": 28.4744,\n  \"longitude\": 77.49\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('verified', () => pm.expect(pm.response.json().status).to.eql('IDENTITY_VERIFIED'));"
