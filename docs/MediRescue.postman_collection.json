    {
      "name": "2. Full demo flow",
      "item": [
        {
          "name": "M1 Create incident (SOS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{fieldToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_request_id\": \"{{$guid}}\",\n  \"latitude\": 28.4744,\n  \"longitude\": 77.49,\n  \"severity\": \"HIGH\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('incidentId', pm.response.json().incident_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "M1 Get demo scan for USR-001",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/demo/test-scan?user_id=USR-001",
              "host": [
                "{{baseUrl}}"
