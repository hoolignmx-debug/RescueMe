# Copy this file to ".env" (same folder) and fill in values. NEVER commit ".env".
# The browser never sees these values: only this Node service reads them.

# Port the service listens on
PORT=8787

# OPTIONAL. If empty, the service runs in SCORING-ENGINE mode (no external LLM).
# If set, the LLM is used to choose between already-validated candidates and write the explanation.
AI_API_KEY=

# LLM settings (defaults shown; change if your provider/model differs)
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=8000

# Extra browser origins allowed to call this service (comma separated).
# http://localhost:* and http://127.0.0.1:* are always allowed for the demo.
ALLOWED_ORIGINS=

# Set to 1 to also serve ../frontend at http://localhost:PORT/ (one command demo)
SERVE_FRONTEND=1
